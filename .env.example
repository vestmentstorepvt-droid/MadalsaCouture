# ── Database (Turso). Leave TURSO_DATABASE_URL empty locally to use .data/madalsa.db ──
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Auth (two different random secrets, 32+ bytes each; keep the old values to keep users logged in) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── URLs ──
APP_URL=https://madalsacouture.com
FRONTEND_URL=https://madalsacouture.com
APP_FRONTEND_URL=https://madalsacouture.com
# Same-origin API; leave empty unless the API lives on another domain.
CORS_ORIGIN=https://madalsacouture.com

# ── Email (client-owned mailbox) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Media: images → Cloudinary, videos → Cloudflare R2 (see src/server/lib/storage.ts) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional overrides: cloudinary | r2
MEDIA_IMAGE_STORAGE=
MEDIA_VIDEO_STORAGE=

# ── Shiprocket Checkout (client's account) ──
SHIPROCKET_API_KEY=
SHIPROCKET_SECRET_KEY=
SELLER_DOMAIN=madalsacouture.com

# ── Meta Pixel + Conversions API ──
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=

# ── Rate limits shared across Vercel instances (Upstash Redis, free tier) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Business settings ──
DEFAULT_EXCHANGE_WINDOW_DAYS=7
FREE_SHIPPING_THRESHOLD_INR=4999
LOW_STOCK_THRESHOLD=5
LOG_LEVEL=info
